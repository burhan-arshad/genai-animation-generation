NICHE=mysteries
FACT_DOMAINS=britannica.com,history.com,smithsonianmag.com,nationalgeographic.com,loc.gov,archives.gov,fbi.gov,bbc.com,theguardian.com,nytimes.com,washingtonpost.com,livescience.com,scientificamerican.com,worldhistory.org,historyextra.com,archaeology.org,nps.gov

PROJECTS_ROOT=
SKILL_PY=
CONTACT=

# ───────────── LLM keys ─────────────
GEMINI_API_KEY=add_your_key_here
PROVIDER_GROQ_URL=https://api.groq.com/openai/v1
PROVIDER_GROQ_KEY=add_your_key_here
PROVIDER_GROQ_MAX_TOKENS=2500
PROVIDER_GROQ_MAX_INPUT_TOKENS=6500
PROVIDER_GROQ_EXTRA='{"reasoning_effort":"low"}'

PROVIDER_GROQ2_URL=https://api.groq.com/openai/v1
PROVIDER_GROQ2_KEY=add_your_key_here
PROVIDER_GROQ2_MAX_TOKENS=2500
PROVIDER_GROQ2_MAX_INPUT_TOKENS=6500
PROVIDER_GROQ2_EXTRA='{"reasoning_effort":"none"}'

PROVIDER_OPENROUTER_URL=https://openrouter.ai/api/v1
PROVIDER_OPENROUTER_KEY=add_your_key_here
PROVIDER_OPENROUTER_MAX_TOKENS=8000
PROVIDER_OPENROUTER_JSON_MODE=0

PROVIDER_SAMBANOVA_URL=https://api.sambanova.ai/v1
PROVIDER_SAMBANOVA_KEY=add_your_key_here
PROVIDER_SAMBANOVA_MAX_TOKENS=6000
PROVIDER_SAMBANOVA_JSON_MODE=0

PROVIDER_CLOUDFLARE_URL=https://api.cloudflare.com/client/v4/accounts/YOUR_ACCOUNT/ai/v1
PROVIDER_CLOUDFLARE_KEY=add_your_key_here
PROVIDER_CLOUDFLARE_MAX_TOKENS=3000
PROVIDER_CLOUDFLARE_MAX_INPUT_TOKENS=6000
PROVIDER_CLOUDFLARE_JSON_MODE=0

# ───────────── LLM behaviour ─────────────
LLM_TRIES=1
LLM_BREAKER_SECONDS=240
LLM_ROUNDS=8

# Groq first for everything that fits in 8K tokens/min (the size guard sends bigger requests on to the next model),
# Gemini only as backup (it fails about 3 of 4 calls at the moment), OpenRouter last.
GEMINI_MODEL=groq:openai/gpt-oss-120b,groq:openai/gpt-oss-20b,sambanova:gpt-oss-120b,gemini-3.5-flash-lite
GEMINI_MODEL_RESEARCH=groq:openai/gpt-oss-20b,groq:openai/gpt-oss-120b,sambanova:gpt-oss-120b,cloudflare:@cf/openai/gpt-oss-120b,gemini-3.5-flash-lite
GEMINI_MODEL_TOPICS=groq:openai/gpt-oss-120b,groq:openai/gpt-oss-20b,sambanova:gpt-oss-120b,cloudflare:@cf/openai/gpt-oss-120b,gemini-3.5-flash-lite
GEMINI_MODEL_FACTCHECK=groq:openai/gpt-oss-20b,groq:openai/gpt-oss-120b,sambanova:gpt-oss-120b,cloudflare:@cf/openai/gpt-oss-120b,gemini-3.5-flash-lite
GEMINI_MODEL_JUDGE=groq:openai/gpt-oss-120b,groq:openai/gpt-oss-20b,sambanova:gpt-oss-120b,sambanova:Meta-Llama-3.3-70B-Instruct,gemini-3.5-flash-lite
GEMINI_MODEL_VOICE=groq:openai/gpt-oss-120b,groq:openai/gpt-oss-20b,sambanova:gpt-oss-120b,gemini-3.5-flash-lite
GEMINI_MODEL_HOOK=groq:openai/gpt-oss-120b,groq:openai/gpt-oss-20b,sambanova:gpt-oss-120b,gemini-3.5-flash-lite
GEMINI_MODEL_SCRIPT=groq:openai/gpt-oss-120b,sambanova:gpt-oss-120b,sambanova:Meta-Llama-3.3-70B-Instruct,sambanova:DeepSeek-V3.1,gemini-3.5-flash-lite,openrouter:nvidia/nemotron-3-ultra-550b-a55b:free
GEMINI_MODEL_STORYBOARD=groq:openai/gpt-oss-120b,groq:openai/gpt-oss-20b,sambanova:gpt-oss-120b,sambanova:Meta-Llama-3.3-70B-Instruct,sambanova:DeepSeek-V3.1,gemini-3.5-flash-lite,openrouter:nvidia/nemotron-3-ultra-550b-a55b:free
GEMINI_MODEL_STORYBOARD_HARD=sambanova:gpt-oss-120b,sambanova:DeepSeek-V3.1,groq:openai/gpt-oss-120b,gemini-3.5-flash-lite,openrouter:nvidia/nemotron-3-ultra-550b-a55b:free

# limits (a model that is not listed gets the DEFAULT_* values)
DEFAULT_DAILY_LIMIT=900
DEFAULT_RPM_LIMIT=25
DAILY_LIMITS=groq:openai/gpt-oss-20b:900,gemini-3.5-flash-lite:500,gemini-2.5-flash-preview-tts:20,openrouter:nvidia/nemotron-3-ultra-550b-a55b:free:15,sambanova:gpt-oss-120b:20,sambanova:Meta-Llama-3.3-70B-Instruct:20,sambanova:DeepSeek-V3.1:20,cloudflare:@cf/openai/gpt-oss-120b:40
RPM_LIMITS=groq:openai/gpt-oss-20b:25,gemini-3.5-flash-lite:5,gemini-2.5-flash-preview-tts:3,openrouter:nvidia/nemotron-3-ultra-550b-a55b:free:8,sambanova:gpt-oss-120b:15,sambanova:Meta-Llama-3.3-70B-Instruct:15,sambanova:DeepSeek-V3.1:15,cloudflare:@cf/openai/gpt-oss-120b:20

# smaller prompts so a free Groq model (8K tokens/min) can take them
EVIDENCE_ITEMS=10
EVIDENCE_CHARS=600
JUDGE_BATCH_CHARS=9000
STORYBOARD_CHUNK_LINES=3
STORYBOARD_ROUNDS=2
STORYBOARD_ACCEPT_SOFT=1
RELEVANCE_CHECK=0
PROPS_CRITIC=0

# voice: Gemini free allows 3 requests a minute; if it fails the local Kokoro voice is used
GEMINI_TTS_MODELS=gemini-2.5-flash-preview-tts
VOICE_SEGMENTS=3

# second, independent source for the fact-check and the topic check
TAVILY_API_KEY=add_your_key_here
FACT_WEB_MAX=4
FACT_MAX_WEAK=1
TOPIC_MIN_FACTS=3
TOPIC_WEB_PROBE=1
PUBMED=0

# ───────────── Daily automation ─────────────
VISION_QA=off

SMTP_USER=add_your_email_here
SMTP_APP_PASSWORD=add_your_app_password_here
ALERT_TO=add_your_email_here
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# ───────────── Dashboard ─────────────
PORT=8321
HOST=127.0.0.1
DASHBOARD_PASSWORD=add_password
CATEGORY_ID=27

# ───────────── Render ─────────────
RENDER_PROFILE=balanced
RENDER_SOFTWARE=0
RENDER_NICE=0
RENDER_WORKERS=3
RENDER_FPS=15

SOURCES_IN_DESCRIPTION=0

MIN_SOURCES=2
SCRIPT_TRIES=4
SCRIPT_ACCEPT_SOFT=1
DAILY_TOKENS=groq:openai/gpt-oss-120b:200000,groq:openai/gpt-oss-20b:200000,sambanova:gpt-oss-120b:200000,sambanova:Meta-Llama-3.3-70B-Instruct:200000,sambanova:DeepSeek-V3.1:200000

GEMINI_MODEL_HOOK=groq:openai/gpt-oss-20b,gemini-3.5-flash-lite
HOOK_AGENT=1
LEARN=1
LEARN_MIN_VIDEOS=8
LEARN_EXPLORE=25
TOPIC_MIN_PAGES=2
TOPIC_MIN_CHARS=2500