# Copy this file to .env and fill it in. Never commit .env.

# ───────────── Which kind of channel? (a file in niches/) ─────────────
NICHE=history

# ───────────── Where things live (leave empty to use the defaults) ─────────────
# Folder of the rendering engine pack (the one that contains SKILL.md). Default: ../faceless-shorts next to this repo
SKILL_DIR=
# Where every video project is created. Default: ~/faceless-shorts
PROJECTS_ROOT=
# Python of the engine pack's own venv (Kokoro + Whisper). Default: ~/.faceless-shorts/venv
SKILL_PY=
# Your repo URL or e-mail: sent to Wikipedia in the User-Agent, as their API etiquette asks
CONTACT=https://github.com/your-name/shorts-agent

# ───────────── LLM: Gemini (free tier works) ─────────────
GEMINI_API_KEY=
# Default model, and one chain per task. A chain is a comma-separated list tried in order; when a model is
# overloaded (5xx), rate-limited (429) or out of daily quota, the next one is used automatically.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_MODEL_RESEARCH=gemini-3.5-flash-lite,gemini-3.1-flash-lite
GEMINI_MODEL_SCRIPT=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.8-flash
GEMINI_MODEL_FACTCHECK=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.8-flash
GEMINI_MODEL_TOPICS=gemini-3.5-flash-lite,gemini-3.1-flash-lite
# Writing the scene code is the hardest task: strongest models first
GEMINI_MODEL_STORYBOARD=gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash-lite
GEMINI_MODEL_STORYBOARD_HARD=gemini-3.8-flash,gemini-3.6-flash
GEMINI_MODEL_VISION=gemini-3.8-flash,gemini-3.5-flash-lite
GEMINI_MODEL_PROPS=gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash-lite
GEMINI_MODEL_PROPS_HARD=gemini-3.8-flash,gemini-3.6-flash
# Free-tier limits of YOUR key (see aistudio.google.com/rate-limit). model:number, comma separated
DAILY_LIMITS=gemini-3.8-flash:20,gemini-3.6-flash:20,gemini-3.5-flash-lite:500,gemini-3.1-flash-lite:500
RPM_LIMITS=gemini-3.8-flash:5,gemini-3.6-flash:5,gemini-3.5-flash-lite:15,gemini-3.1-flash-lite:15
LLM_TIMEOUT_MS=180000
# After two failed calls in a row a model is skipped for this many seconds (circuit breaker)
LLM_BREAKER_SECONDS=180

# ───────────── Optional: any OpenAI-compatible provider as a fallback (or instead of Gemini) ─────────────
# Name it anything, then use "name:model" in a chain, e.g. GEMINI_MODEL_SCRIPT=gemini-3.5-flash-lite,groq:llama-3.3-70b-versatile
# Look up the base URL and the free-tier limits in the provider's own docs.
# PROVIDER_GROQ_URL=https://api.groq.com/openai/v1
# PROVIDER_GROQ_KEY=
# PROVIDER_GROQ_MAX_TOKENS=8000
# DAILY_LIMITS can list them too: groq:llama-3.3-70b-versatile:1000

# ───────────── Daily automation ─────────────
VIDEOS_PER_DAY=1
# YouTube: private until you trust the pipeline, then unlisted, then public
UPLOAD_PRIVACY=private
# true = set YouTube's "altered or synthetic content" flag (meant for REALISTIC synthetic media; read YouTube's policy)
SYNTHETIC_DISCLOSURE=false
# Overrides the niche's YouTube category (27 = Education)
CATEGORY_ID=
# Only with UPLOAD_PRIVACY=public: publish at this UTC hour (0-23) instead of immediately
# PUBLISH_AT_UTC_HOUR=17
# off | advisory | gate  (experimental; it was inconsistent in tests, keep it off)
VISION_QA=off

SMTP_USER=
SMTP_APP_PASSWORD=
ALERT_TO=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# ───────────── Dashboard ─────────────
PORT=8000
